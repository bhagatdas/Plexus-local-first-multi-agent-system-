---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	planner(planner)
	executor(executor)
	verifier(verifier)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	executor -.-> verifier;
	planner --> executor;
	router -.-> __end__;
	router -.-> planner;
	verifier -.-> __end__;
	verifier -.-> planner;
	executor -.-> executor;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
